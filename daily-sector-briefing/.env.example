# Copy this file to `.env` and fill in your key. `.env` is gitignored.
#
# Free Polygon ("Stocks Basic") key — used as the primary EOD equity source.
# Get one at https://polygon.io  (the free tier is sufficient for the EOD briefing).
# In GitHub Actions this is provided as a repository secret named POLYGON_API_KEY instead.
POLYGON_API_KEY=

# Optional: set to "polygon", "yfinance", or "hybrid" (default: hybrid).
BRIEFING_PROVIDER=hybrid
