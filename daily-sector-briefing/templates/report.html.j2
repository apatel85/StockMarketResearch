<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Sector Briefing — {{ as_of }} {{ session|upper }}</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<style>
  :root{--bg:#0d1117;--card:#161b22;--line:#21262d;--fg:#e6edf3;--mut:#8b949e;
        --up:#3fb950;--dn:#f85149;--accent:#58a6ff;--warn:#d29922;}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--fg);
       font:14px/1.5 -apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif}
  header{padding:16px 20px;border-bottom:1px solid var(--line);
         display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between}
  h1{font-size:18px;margin:0}
  .meta{color:var(--mut);font-size:12px}
  .badge{padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600}
  .ok{background:rgba(63,185,80,.15);color:var(--up)}
  .stale{background:rgba(248,81,73,.15);color:var(--dn)}
  nav{display:flex;flex-wrap:wrap;gap:4px;padding:10px 16px;border-bottom:1px solid var(--line);
      position:sticky;top:0;background:var(--bg);z-index:5}
  nav button{background:transparent;border:1px solid var(--line);color:var(--mut);
             padding:7px 12px;border-radius:8px;cursor:pointer;font-size:13px}
  nav button.active{color:var(--fg);border-color:var(--accent);background:rgba(88,166,255,.1)}
  main{padding:18px 20px;max-width:1280px;margin:0 auto}
  .tab{display:none} .tab.active{display:block}
  .grid{display:grid;gap:12px;grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}
  .card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px}
  .card .k{color:var(--mut);font-size:12px} .card .v{font-size:20px;font-weight:600;margin-top:2px}
  table{width:100%;border-collapse:collapse;margin-top:8px;font-size:13px}
  th,td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--line)}
  th{color:var(--mut);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.03em}
  tr:hover td{background:rgba(255,255,255,.02)}
  .up{color:var(--up)} .dn{color:var(--dn)} .mut{color:var(--mut)}
  .pill{display:inline-block;padding:1px 7px;border-radius:8px;font-size:11px;font-weight:600}
  .pill.long,.pill.bullish{background:rgba(63,185,80,.15);color:var(--up)}
  .pill.short,.pill.bearish{background:rgba(248,81,73,.15);color:var(--dn)}
  .pill.neutral{background:rgba(139,148,158,.15);color:var(--mut)}
  .pill.lead{background:rgba(63,185,80,.12);color:var(--up)}
  .pill.lag{background:rgba(248,81,73,.12);color:var(--dn)}
  .pill.improve{background:rgba(88,166,255,.12);color:var(--accent)}
  .pill.weaken{background:rgba(210,153,34,.12);color:var(--warn)}
  .conf{height:7px;border-radius:4px;background:var(--line);overflow:hidden;min-width:60px;flex:1}
  .conf>i{display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--up))}
  h2{font-size:15px;border-left:3px solid var(--accent);padding-left:8px;margin:20px 0 6px}
  h3{font-size:13px;color:var(--mut);margin:14px 0 4px}
  .note{color:var(--mut);font-size:12px}
  ul.notes{margin:6px 0 0;padding-left:16px} ul.notes li{color:var(--mut);font-size:12px}

  /* ---- compact sector filter chips ---- */
  .filterbar{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0 4px}
  .chip{cursor:pointer;border:1px solid var(--line);border-radius:8px;padding:4px 9px;
        background:var(--card);font-size:12px;display:flex;gap:6px;align-items:center;white-space:nowrap}
  .chip:hover{border-color:var(--accent)}
  .chip.active{border-color:var(--accent);background:rgba(88,166,255,.12)}
  .chip b{font-weight:600}
  .chip .c{font-size:11px}
  .subbar{margin:4px 0 0}
  .subbar .chip{font-size:11px;padding:3px 7px;background:transparent;color:var(--mut)}

  /* ---- side-by-side winners/losers ---- */
  .duo{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .duo h3{margin-top:6px}
  @media(max-width:760px){.duo{grid-template-columns:1fr}}
  table.compact th,table.compact td{padding:4px 6px;font-size:12px}
  .sym{font-weight:700}

  /* ---- trade setup grid ---- */
  .setupgrid{display:grid;gap:12px;grid-template-columns:repeat(auto-fill,minmax(290px,1fr))}
  .idea{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px;
        cursor:pointer;transition:border-color .15s}
  .idea:hover{border-color:var(--accent)}
  .idea .hd{display:flex;justify-content:space-between;align-items:center;gap:8px}
  .idea .sym{font-size:15px}
  .lv{display:flex;gap:12px;flex-wrap:wrap;margin:7px 0;color:var(--mut);font-size:12px}
  .lv b{color:var(--fg)}
  .strat{border-top:1px dashed var(--line);margin-top:8px;padding-top:7px;font-size:12px}
  .strat ol{margin:4px 0 0;padding-left:16px} .strat li{margin:2px 0;color:var(--mut)}
  .chartlink{font-size:11px;color:var(--accent)}

  /* ---- glossary term + tooltip ---- */
  .term{border-bottom:1px dotted var(--accent);cursor:help}
  #tip{position:fixed;max-width:300px;background:#1c2430;border:1px solid var(--accent);
       color:var(--fg);padding:9px 11px;border-radius:8px;font-size:12px;line-height:1.45;
       box-shadow:0 6px 20px rgba(0,0,0,.5);z-index:50;display:none}
  .disclaimer{color:var(--mut);font-size:11px;border-top:1px solid var(--line);
              margin-top:30px;padding-top:12px}
  canvas{max-height:280px}
</style>
</head>
<body>
<header>
  <div>
    <h1>📊 Daily Sector Briefing</h1>
    <div class="meta">{{ as_of }} · {{ session_label }} · provider: {{ provider }} ·
      generated {{ generated_at }}</div>
  </div>
  <div>
    {% if freshness.ok %}<span class="badge ok">DATA FRESH · {{ freshness.expected_day }}</span>
    {% else %}<span class="badge stale">DATA FLAGGED</span>{% endif %}
  </div>
</header>

<nav id="nav"></nav>
<div id="tip"></div>
<main>
  <!-- 1. OVERVIEW -->
  <section class="tab" data-tab="Overview">
    <h2>Market Pulse</h2>
    <div class="grid">
      {% for q in market_pulse.indices + market_pulse.futures %}
      <div class="card"><div class="k">{{ q.symbol }}</div>
        <div class="v {{ 'up' if q.chg_1d>=0 else 'dn' }}">{{ q.chg_1d|pct }}</div>
        <div class="note">{{ q.last|num }}</div></div>
      {% endfor %}
      <div class="card"><div class="k"><span class="term" data-g="vix">VIX</span> ({{ market_pulse.vix.regime }})</div>
        <div class="v">{{ market_pulse.vix.last|num }}</div></div>
      {% for q in market_pulse.rates + market_pulse.intermarket %}
      <div class="card"><div class="k">{{ q.symbol }}</div>
        <div class="v {{ 'up' if q.chg_1d>=0 else 'dn' }}">{{ q.chg_1d|pct }}</div></div>
      {% endfor %}
    </div>
    {% if market_pulse.breadth %}
    <h2><span class="term" data-g="breadth">Breadth</span></h2>
    <div class="grid">
      <div class="card"><div class="k">Advancers</div><div class="v up">{{ market_pulse.breadth.adv }}</div></div>
      <div class="card"><div class="k">Decliners</div><div class="v dn">{{ market_pulse.breadth.decl }}</div></div>
    </div>{% endif %}
    {% if session_note %}<h2>Session Notes</h2><p class="note">{{ session_note }}</p>{% endif %}
  </section>

  <!-- 2. SECTORS -->
  <section class="tab" data-tab="Sectors">
    <h2>Sector Performance (1-Day)</h2>
    <canvas id="sectorChart"></canvas>
    {% if sectors.hot_day %}
    <p>🔥 Hot today: <b class="up">{{ sectors.hot_day.hot.sector }}</b> ({{ sectors.hot_day.hot.chg|pct }})
       · 🧊 Cold: <b class="dn">{{ sectors.hot_day.cold.sector }}</b> ({{ sectors.hot_day.cold.chg|pct }})</p>{% endif %}
    {% if sectors.hot_week %}
    <p>📅 Hot this week: <b class="up">{{ sectors.hot_week.hot.sector }}</b> ({{ sectors.hot_week.hot.chg|pct }})
       · Cold: <b class="dn">{{ sectors.hot_week.cold.sector }}</b> ({{ sectors.hot_week.cold.chg|pct }})</p>{% endif %}
    <table><thead><tr><th>Sector</th><th>ETF</th><th>1D</th><th>1W</th><th>1M</th></tr></thead><tbody>
      {% for r in sectors.etf_perf %}<tr><td>{{ r.sector }}</td><td class="mut">{{ r.etf }}</td>
      <td class="{{ 'up' if r.chg_1d>=0 else 'dn' }}">{{ r.chg_1d|pct }}</td>
      <td class="{{ 'up' if r.chg_5d>=0 else 'dn' }}">{{ r.chg_5d|pct }}</td>
      <td>{{ r.chg_20d|pct }}</td></tr>{% endfor %}
    </tbody></table>

    <h2>Sub-sectors (constituent median, 1-Day)</h2>
    <table><thead><tr><th>Sector</th><th>Sub-sector</th><th>Median</th><th>% Up</th><th>#</th></tr></thead><tbody>
      {% for r in sectors.subsectors %}<tr><td class="mut">{{ r.sector }}</td><td>{{ r.industry }}</td>
      <td class="{{ 'up' if r.median>=0 else 'dn' }}">{{ r.median|pct }}</td>
      <td>{{ r.pct_up|num }}%</td><td class="mut">{{ r.count }}</td></tr>{% endfor %}
    </tbody></table>

    {% if sectors.rrg %}
    <h2><span class="term" data-g="rrg">Rotation (RRG)</span> quadrants vs SPY</h2>
    <table><thead><tr><th>Sector</th><th><span class="term" data-g="relative_strength">Rel. Strength</span></th>
      <th>Momentum</th><th><span class="term" data-g="quadrant">Quadrant</span></th></tr></thead><tbody>
      {% for r in sectors.rrg %}<tr><td>{{ r.sector }}</td>
      <td class="{{ 'up' if r.rs>=0 else 'dn' }}">{{ r.rs|pct }}</td>
      <td class="{{ 'up' if r.momentum>=0 else 'dn' }}">{{ r.momentum|pct }}</td>
      <td><span class="pill {{ {'Leading':'lead','Lagging':'lag','Improving':'improve','Weakening':'weaken'}[r.quadrant] }}">{{ r.quadrant }}</span></td></tr>{% endfor %}
    </tbody></table>{% endif %}
  </section>

  <!-- 3. WINNERS & LOSERS (sector-filterable, side by side) -->
  <section class="tab" data-tab="Winners & Losers">
    <h2>Top 10 Winners &amp; Losers</h2>
    <p class="note">Click a sector to filter. Default is the whole market.</p>
    <div class="filterbar" id="moversBar"></div>
    <h3>Today — <span id="mvDayLabel">Overall</span></h3>
    <div class="duo">
      <div><h3 class="up">▲ Winners</h3><div id="mvDayWin"></div></div>
      <div><h3 class="dn">▼ Losers</h3><div id="mvDayLose"></div></div>
    </div>
    <h3>This Week — <span id="mvWeekLabel">Overall</span></h3>
    <div class="duo">
      <div><h3 class="up">▲ Winners</h3><div id="mvWeekWin"></div></div>
      <div><h3 class="dn">▼ Losers</h3><div id="mvWeekLose"></div></div>
    </div>
  </section>

  <!-- 4. OPTIONS FLOW (sector-filterable) -->
  <section class="tab" data-tab="Options Flow">
    <h2>Options Positioning</h2>
    <p class="note">Click a sector to filter.
      <span class="term" data-g="put_call">P/C</span> low = call-heavy/bullish ·
      <span class="term" data-g="vol_oi">Vol/OI</span> flags unusual activity. Snapshot data — see disclaimer.</p>
    <div class="filterbar" id="optBar"></div>
    <div id="optTable"></div>
  </section>

  <!-- 5. IDEAS (longs & shorts) -->
  <section class="tab" data-tab="Long & Short Ideas">
    {% macro ideatable(rows) %}
    <table class="compact"><thead><tr><th>Symbol</th><th><span class="term" data-g="bias">Bias</span></th>
      <th><span class="term" data-g="confidence">Confidence</span></th><th>Drivers</th></tr></thead><tbody>
      {% for r in rows %}<tr><td><b>{{ r.symbol }}</b> <span class="note">{{ r.sector }}</span></td>
      <td><span class="pill {{ r.bias }}">{{ r.bias }}</span></td>
      <td><div style="display:flex;align-items:center;gap:8px"><div class="conf"><i style="width:{{ r.confidence }}%"></i></div>{{ r.confidence }}%</div></td>
      <td class="note">{{ r.notes[:3]|join('; ') }}</td></tr>{% endfor %}
    </tbody></table>{% endmacro %}
    <h2>Long Candidates</h2>{{ ideatable(longs) if longs else '<p class="note">None above threshold today.</p>'|safe }}
    <h2>Short Candidates</h2>{{ ideatable(shorts) if shorts else '<p class="note">None above threshold today.</p>'|safe }}
  </section>

  <!-- 6. TRADE SETUPS (grid, click to open chart) -->
  <section class="tab" data-tab="Trade Setups">
    <h2>Ranked Setups</h2>
    <p class="note">Click any card to open its chart.
      <span class="term" data-g="entry">Entry</span> /
      <span class="term" data-g="stop">Stop</span> /
      <span class="term" data-g="target">Target</span> ·
      <span class="term" data-g="rr">R:R</span></p>
    <div class="setupgrid">
    {% for r in ideas %}
      <div class="idea" data-sym="{{ r.symbol }}">
        <div class="hd">
          <div><span class="sym">{{ r.symbol }}</span> <span class="pill {{ r.bias }}">{{ r.bias|upper }}</span></div>
          <div class="note">conf {{ r.confidence }}%{% if r.earnings_soon %} · <span class="pill weaken">ER soon</span>{% endif %}</div>
        </div>
        <div class="note">{{ r.name }} · {{ r.sector }}</div>
        {% if r.levels %}
        <div class="lv"><span>E <b>{{ r.levels.entry|num }}</b></span>
          <span>S <b class="dn">{{ r.levels.stop|num }}</b></span>
          <span>T <b class="up">{{ r.levels.target|num }}</b></span>
          <span>R:R <b>{{ r.levels.rr }}</b></span></div>{% endif %}
        <div class="strat"><b>Options:</b>
          <ol>{% for s in r.option_strategies %}<li><b>{{ s.name }}</b> — {{ s.rationale }} <span class="note">[{{ s.tenor }}]</span></li>{% endfor %}</ol>
        </div>
        <div class="chartlink">📈 click to open chart →</div>
      </div>
    {% endfor %}
    </div>
  </section>

  <!-- 7. FUTURES & LEVELS -->
  <section class="tab" data-tab="Futures & Levels">
    <h2>ES / NQ Key Levels</h2>
    <div class="grid">
      {% for k in ['ES','NQ'] %}{% set f = futures[k] %}{% if f.available %}
      <div class="card"><div class="k">{{ f.symbol }}</div>
        <div class="v">{{ f.last|num }}</div>
        <div class="note">PDH {{ f.prior_high|num }} · PDL {{ f.prior_low|num }}</div>
        <div class="note"><span class="term" data-g="atr">ATR</span> {{ f.atr|num }} · range {{ f.expected_range[0]|num }}–{{ f.expected_range[1]|num }}</div>
      </div>{% endif %}{% endfor %}
      {% if futures.VIX_implied.available %}
      <div class="card"><div class="k"><span class="term" data-g="expected_move">VIX-implied move</span></div>
        <div class="v">±{{ futures.VIX_implied.implied_daily_move_pct|num }}%</div>
        <div class="note">SPX band {{ futures.VIX_implied.implied_band[0]|num }}–{{ futures.VIX_implied.implied_band[1]|num }}</div></div>{% endif %}
      {% if futures.gamma_flip.available %}
      <div class="card"><div class="k"><span class="term" data-g="gamma_flip">SPX gamma-flip proxy</span></div>
        <div class="v">{{ futures.gamma_flip.proxy_level|num }}</div>
        <div class="note">{{ futures.gamma_flip.note }}</div></div>{% endif %}
    </div>
  </section>

  <!-- 8. WATCHLIST -->
  <section class="tab" data-tab="Watchlist">
    <h2>To Monitor</h2>
    <h3>Sectors</h3><p>{{ watchlist.sectors|join(', ') }}</p>
    <h3>Sub-sectors</h3><p>{{ watchlist.subsectors|join(', ') }}</p>
    <h3>Stocks</h3><p>{{ watchlist.stocks|join(', ') }}</p>
  </section>

  <!-- 9. ACCURACY -->
  <section class="tab" data-tab="Accuracy">
    <h2>Signal Accuracy (rolling archive)</h2>
    {% if accuracy.available %}
    <div class="grid">
      <div class="card"><div class="k">Overall hit-rate</div><div class="v">{{ (accuracy.hit_rate*100)|num }}%</div><div class="note">n={{ accuracy.n }}</div></div>
      <div class="card"><div class="k">Long hit-rate</div><div class="v up">{{ (accuracy.hit_rate_long*100)|num if accuracy.hit_rate_long is not none else '—' }}%</div></div>
      <div class="card"><div class="k">Short hit-rate</div><div class="v dn">{{ (accuracy.hit_rate_short*100)|num if accuracy.hit_rate_short is not none else '—' }}%</div></div>
    </div>
    <h3>By <span class="term" data-g="confidence">confidence</span> bucket</h3>
    <table><thead><tr><th>Bucket</th><th>Hit-rate</th><th>n</th></tr></thead><tbody>
      {% for b,v in accuracy.by_confidence.items() %}<tr><td>{{ b }}</td><td>{{ (v.hit_rate*100)|num }}%</td><td class="mut">{{ v.n }}</td></tr>{% endfor %}
    </tbody></table>
    {% else %}<p class="note">Not enough archived sessions yet — accuracy populates as the 30-day history builds.</p>{% endif %}
    {% if outofbox %}<h2>Out-of-the-box signals</h2><ul class="notes">{% for o in outofbox %}<li>{{ o }}</li>{% endfor %}</ul>{% endif %}
  </section>

  <p class="disclaimer">{{ disclaimer }}</p>
</main>

<script>
  const SECTOR_CHART = {{ sector_chart_json|safe }};
  const MOVERS = {{ movers_filter_json|safe }};
  const SECTOR_CARDS = {{ sector_cards_json|safe }};
  const OPTIONS = {{ options_rows_json|safe }};
  const GLOSSARY = {{ glossary_json|safe }};

  /* ---------- tabs ---------- */
  const tabs = [...document.querySelectorAll('.tab')];
  const nav = document.getElementById('nav');
  tabs.forEach((t,i)=>{
    const b=document.createElement('button');
    b.textContent=t.dataset.tab; if(i===0)b.classList.add('active');
    b.onclick=()=>{tabs.forEach(x=>x.classList.remove('active'));
      [...nav.children].forEach(x=>x.classList.remove('active'));
      t.classList.add('active'); b.classList.add('active'); window.scrollTo(0,0);};
    nav.appendChild(b);
  });
  if(tabs[0]) tabs[0].classList.add('active');

  /* ---------- helpers ---------- */
  const fmtPct = v => (v==null||isNaN(v))?'—':(v>=0?'+':'')+Number(v).toFixed(2)+'%';
  const fmtNum = v => (v==null||isNaN(v))?'—':Number(v).toLocaleString(undefined,{maximumFractionDigits:2});
  const cls = v => (v>=0?'up':'dn');
  const esc = s => (s==null?'':String(s)).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
  const shortSec = s => ({'Information Technology':'Tech','Health Care':'Health','Consumer Discretionary':'Cons Disc',
    'Communication Services':'Comms','Consumer Staples':'Staples','Real Estate':'RE'}[s]||s);

  /* ---------- glossary tooltip ---------- */
  const tip = document.getElementById('tip');
  let pinned = false;
  function showTip(el){
    const key = el.dataset.g; const txt = GLOSSARY[key];
    if(!txt) return;
    tip.textContent = txt; tip.style.display='block';
    const r = el.getBoundingClientRect();
    let top = r.bottom+8, left = Math.min(r.left, window.innerWidth-tip.offsetWidth-12);
    if(top+tip.offsetHeight>window.innerHeight) top = r.top-tip.offsetHeight-8;
    tip.style.top=top+'px'; tip.style.left=Math.max(8,left)+'px';
  }
  function hideTip(){ if(!pinned){ tip.style.display='none'; } }
  function bindTerms(root){
    (root||document).querySelectorAll('.term').forEach(el=>{
      if(el._bound) return; el._bound=true; el.tabIndex=0;
      el.addEventListener('mouseenter',()=>{ if(!pinned) showTip(el); });
      el.addEventListener('mouseleave',hideTip);
      el.addEventListener('focus',()=>showTip(el));
      el.addEventListener('blur',hideTip);
      el.addEventListener('click',e=>{ e.stopPropagation();
        if(pinned && tip.style.display==='block'){ pinned=false; tip.style.display='none'; }
        else { pinned=true; showTip(el); } });
    });
  }
  document.addEventListener('click',()=>{ pinned=false; tip.style.display='none'; });

  /* ---------- movers table render ---------- */
  function moversTable(rows, horizon){
    const chg = horizon==='day'?'chg_1d':'chg_5d';
    let h='<table class="compact"><thead><tr><th>#</th><th>Sym</th><th>Sec</th><th>%</th><th>Close</th></tr></thead><tbody>';
    (rows||[]).forEach((r,i)=>{
      h+=`<tr><td class="mut">${i+1}</td><td><span class="sym">${esc(r.symbol)}</span>`+
         `<div class="note">${esc(r.catalyst||r.name||'')}</div></td>`+
         `<td class="mut">${esc(shortSec(r.sector))}</td>`+
         `<td class="${cls(r[chg])}">${fmtPct(r[chg])}</td><td>${fmtNum(r.close)}</td></tr>`;
    });
    return h+'</tbody></table>';
  }
  let moverSector='Overall';
  function renderMovers(){
    const blk = MOVERS[moverSector] || MOVERS['Overall'] || {day:{},week:{}};
    document.getElementById('mvDayWin').innerHTML = moversTable(blk.day&&blk.day.winners,'day');
    document.getElementById('mvDayLose').innerHTML = moversTable(blk.day&&blk.day.losers,'day');
    document.getElementById('mvWeekWin').innerHTML = moversTable(blk.week&&blk.week.winners,'week');
    document.getElementById('mvWeekLose').innerHTML = moversTable(blk.week&&blk.week.losers,'week');
    document.getElementById('mvDayLabel').textContent = moverSector;
    document.getElementById('mvWeekLabel').textContent = moverSector;
    bindTerms(document.querySelector('[data-tab="Winners & Losers"]'));
  }

  /* ---------- options table render ---------- */
  let optSector='Overall';
  function renderOptions(){
    const rows = OPTIONS.filter(r=> optSector==='Overall' || r.sector===optSector);
    let h='<table class="compact"><thead><tr><th>Sym</th><th><span class="term" data-g="bias">Bias</span></th>'+
      '<th><span class="term" data-g="put_call">P/C Vol</span></th>'+
      '<th><span class="term" data-g="atm_iv">ATM IV</span></th>'+
      '<th><span class="term" data-g="expected_move">Exp.Move</span></th>'+
      '<th><span class="term" data-g="unusual">Unusual</span></th></tr></thead><tbody>';
    if(!rows.length) h+='<tr><td colspan="6" class="note">No options data for this sector.</td></tr>';
    rows.forEach(r=>{ h+=`<tr><td><b>${esc(r.symbol)}</b></td>`+
      `<td><span class="pill ${esc(r.bias)}">${esc(r.bias)}</span></td>`+
      `<td>${fmtNum(r.pc_ratio_vol)}</td>`+
      `<td>${r.atm_iv?fmtNum(r.atm_iv*100)+'%':'—'}</td>`+
      `<td>${fmtNum(r.expected_move_pct)}%</td><td class="mut">${r.unusual_count||0}</td></tr>`; });
    document.getElementById('optTable').innerHTML = h+'</tbody></table>';
    bindTerms(document.getElementById('optTable'));
  }

  /* ---------- sector filter chips ---------- */
  function buildBar(elId, getActive, setActive){
    const bar=document.getElementById(elId); bar.innerHTML='';
    SECTOR_CARDS.forEach(c=>{
      const chip=document.createElement('div'); chip.className='chip'+(c.sector===getActive()?' active':'');
      chip.innerHTML=`<b>${esc(shortSec(c.sector))}</b><span class="c ${cls(c.chg_1d)}">${fmtPct(c.chg_1d)}</span>`;
      chip.onclick=()=>{ setActive(c.sector);
        [...bar.children].forEach(x=>x.classList.remove('active')); chip.classList.add('active'); };
      bar.appendChild(chip);
    });
  }
  buildBar('moversBar',()=>moverSector,s=>{moverSector=s;renderMovers();});
  buildBar('optBar',()=>optSector,s=>{optSector=s;renderOptions();});
  renderMovers(); renderOptions();

  /* ---------- trade setup -> open chart ---------- */
  document.querySelectorAll('.idea').forEach(card=>{
    card.addEventListener('click',()=>{
      const sym=card.dataset.sym;
      if(confirm('Open chart for '+sym+' on TradingView?'))
        window.open('https://www.tradingview.com/chart/?symbol='+encodeURIComponent(sym),'_blank');
    });
  });

  /* ---------- sector bar chart ---------- */
  if(SECTOR_CHART && SECTOR_CHART.labels && window.Chart){
    new Chart(document.getElementById('sectorChart'),{
      type:'bar',
      data:{labels:SECTOR_CHART.labels,datasets:[{data:SECTOR_CHART.values,
        backgroundColor:SECTOR_CHART.values.map(v=>v>=0?'#3fb950':'#f85149')}]},
      options:{plugins:{legend:{display:false}},
        scales:{x:{ticks:{color:'#8b949e'}},y:{ticks:{color:'#8b949e'}}}}
    });
  }

  bindTerms(document);
</script>
</body>
</html>
